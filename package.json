{
  "name": "obyx",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "linkify-it": "5.0.2"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  },
  "dependencies": {
    "@circle-fin/modular-wallets-core": "^1.0.15",
    "@dynamic-labs-sdk/client": "^1.23.0",
    "@dynamic-labs-sdk/evm": "^1.23.0",
    "@dynamic-labs/ethereum-aa": "^4.94.0",
    "viem": "^2.55.10"
  }
}
