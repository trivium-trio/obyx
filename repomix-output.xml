/* ═══════════════════════════════════════════════════
   OBYX DESIGN SYSTEM
   Dual-mode: Premium Fintech + Cyberpunk Crypto
   ═══════════════════════════════════════════════════ */

@theme inline {
  /* ── Base shadcn tokens ── */
